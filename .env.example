# Copy to `.env` and fill in. `.env` is gitignored.

# Neon PostgreSQL — use the POOLED string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Auth.js session secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# The seed script promotes this address to MODERATOR.
# Use the Google account you will sign in with.
MODERATOR_EMAIL=""

# AWS SES v2
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_FROM_EMAIL="no-reply@your-verified-domain.com"

# "true" logs emails to the console instead of calling SES.
# Leave true until your SES identities are verified.
EMAIL_DRY_RUN="true"

# Used to build absolute links inside notification emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
