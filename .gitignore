# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the template, ignore real secrets
!.env.example

# prisma generated client (run `npx prisma generate` after cloning)
/src/generated

# simulated image uploads
/public/uploads/*
!/public/uploads/.gitkeep
.claude
# local tooling and study notes, not part of the deliverable
/.claude
scripts
CLAUDE.md
AGENTS.md
CODE-EXPLAINED.md
PROJECT-GUIDE.md
TESTING.md